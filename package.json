{
	"name": "orchflow",
	"version": "0.0.11",
	"description": "react orchestrator hook",
	"type": "module",
	"license": "MIT",
	"homepage": "https://orchflow.vercel.app",
	"bugs": {
		"url": "https://github.com/sohanemon/orchflow/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sohanemon/orchflow.git"
	},
	"author": "Sohan Emon <sohanemon@outlook.com>",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"play": "vite --config playground/vite.config.ts",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"release": "bumpp && pnpm publish",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.7",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@tsconfig/strictest": "^2.0.6",
		"@types/node": "^24.9.1",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"@vitejs/plugin-react": "^5.0.4",
		"bumpp": "^10.3.1",
		"happy-dom": "^20.0.8",
		"tsdown": "^0.15.9",
		"typescript": "^5.9.3",
		"vite": "npm:rolldown-vite@^7.1.19",
		"vitest": "^4.0.1"
	},
	"packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
